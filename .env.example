# Existing Agent runtime: server-side only
SERVICE_BASE_URL=https://your-authorized-virtual-patient-service.example
SERVICE_TRAIN_TOKEN=replace-me
MODEL_API_KEY=replace-me
TEAM_ID=replace-me
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus

# ClinicaLens C-end authentication
CARE_PUBLIC_DEPLOYMENT=false
CARE_AUTH_SECRET=replace-with-at-least-32-random-characters
CARE_DEV_OTP_CODE=246810
CARE_DEV_CLINICIAN_PHONES=13900000000
CARE_SMS_PROVIDER_URL=
CARE_SMS_PROVIDER_TOKEN=
CARE_COOKIE_SECURE=false
CARE_ALLOWED_ORIGINS=http://127.0.0.1:7860

# Durable structured state: PostgreSQL in production, SQLite locally
CARE_DATABASE_URL=
CARE_DB_PATH=.care_data/clinicalens.db

# Encrypted S3-compatible document storage; required for public uploads
CARE_S3_BUCKET=
CARE_S3_ENDPOINT=
CARE_S3_REGION=
CARE_S3_ACCESS_KEY_ID=
CARE_S3_SECRET_ACCESS_KEY=

# Official registration destination and allowlist
CARE_APPOINTMENT_URL=https://www.114yygh.com/
CARE_APPOINTMENT_HOSTS=www.114yygh.com,114yygh.com

# PWA push
CARE_VAPID_PUBLIC_KEY=
CARE_VAPID_PRIVATE_KEY=
CARE_VAPID_SUBJECT=mailto:security@example.com
CARE_REMINDER_POLL_SECONDS=60

# Public static configuration; contains no secret
CARE_API_BASE_URL=http://127.0.0.1:7860

# Read-only sample compatibility and optional live Agent run
DEMO_LIVE_ENABLED=false
DEMO_PUBLIC_DEPLOYMENT=true
SERVER_TEST_ACCESS_TOKEN=replace-with-a-random-admin-token
DEMO_CASE_MAP_JSON={"electrolyte-signal":"private-id-1","multi-organ-pattern":"private-id-2","negative-evidence":"private-id-3"}
DEMO_DAILY_LIMIT=10
DEMO_IP_DAILY_LIMIT=2
DEMO_MAX_QUEUE=3
DEMO_JOB_TTL_SECONDS=1800
DEMO_RUN_TIMEOUT_SECONDS=240
DEMO_RATE_LIMIT_SALT=replace-with-at-least-16-random-characters
DEMO_ALLOWED_ORIGINS=http://127.0.0.1:7860
DEMO_TRUST_PROXY=false

# Redis REST credentials for public sample limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
